{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ai-wdio": {
      "type": "local",
      "command": ["npx", "ts-node", "src/mcp/server.ts"],
      "enabled": true
    },
    "wdio": {
      "type": "local",
      "command": ["node", "./node_modules/@wdio/mcp/lib/server.js"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "cwd": ".",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}" },
      "enabled": true
    },
    "ollama": {
      "type": "local",
      "command": ["npx", "-y", "ollama-mcp-server"],
      "enabled": true
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "instructions": [".opencode/mcp-reference.md", ".zencoder/rules/repo.md"]
}
