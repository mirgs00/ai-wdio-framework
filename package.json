{
  "name": "ai-wdio-framework",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered WebdriverIO test generation and self-healing framework",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@wdio/globals": "^9.27.1",
    "@wdio/mcp": "^3.5.1",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "arg": "^4.1.3",
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "create-require": "^1.1.1",
    "diff": "^4.0.4",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "is-url": "^1.2.4",
    "make-error": "^1.3.6",
    "mammoth": "^1.12.0",
    "papaparse": "^5.5.3",
    "puppeteer": "^25.1.0",
    "shell-quote": "^1.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "undici-types": "^7.25.0",
    "v8-compile-cache-lib": "^3.0.1",
    "webdriverio": "^9.27.1",
    "yn": "^3.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/domhandler": "^3.1.0",
    "@types/is-url": "^1.2.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.4",
    "@types/node-fetch": "^2.6.13",
    "@types/shell-quote": "^1.7.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@wdio/appium-service": "^9.27.1",
    "@wdio/cli": "^9.27.1",
    "@wdio/cucumber-framework": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.9",
    "appium-xcuitest-driver": "^9.10.5",
    "eslint": "^8.57.1",
    "expect-webdriverio": "^5.6.5",
    "gherkin": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.10"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "test": "jest --config jest.config.ts",
    "generate": "npx ts-node src/cli.ts https://practicetestautomation.com/practice-test-login/ \"Test the login page with different type of credentials positive and negative flows\"",
    "android": "npx wdio configs/wdio.android.conf.ts",
    "ios": "npx wdio configs/wdio.ios.conf.ts",
    "scanMobile": "npx ts-node src/utils/mobile/scanMobileApp.ts",
    "ollama:start": "ollama serve",
    "ollama:pull": "ollama pull llama3",
    "ollama:check": "curl http://localhost:11434/api/tags",
    "ollama:setup": "npm run ollama:pull",
    "setup": "npm install && npm run ollama:setup",
    "generateInstructions": "npx ts-node src/cli.ts --instructions --no-run",
    "generateAndRun": "npx ts-node src/cli.ts --instructions",
    "generateAndRunWithOllama": "npx ts-node src/cli.ts --instructions --use-ollama",
    "mcp:server": "npx ts-node src/mcp/server.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector npx ts-node src/mcp/server.ts",
    "lint": "eslint src --ext .ts --fix",
    "lint:check": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test:watch": "jest --watch",
    "clean": "rm -f src/step-definitions/generatedSteps.ts src/page-objects/generatedPage.ts && rm -f src/features/generated_*.feature",
    "format": "prettier --write \"src/**/*.{ts,json}\""
  },
  "overrides": {
    "ws": "8.20.1",
    "fast-uri": "3.1.2",
    "picomatch": "4.0.4",
    "flatted": "3.4.2",
    "ip-address": "10.2.0",
    "qs": "6.15.2",
    "tmp": "0.2.5",
    "on-headers": "1.1.0",
    "basic-ftp": "5.3.1",
    "brace-expansion": "2.0.3",
    "minimatch": "3.1.4",
    "yaml": "2.9.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
