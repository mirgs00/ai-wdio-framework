# ─────────────────────────────────────────────────────────────────────────────
# ai-wdio-framework environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── WebDriverIO ───────────────────────────────────────────────────────────────
# Base URL for the application under test (used in wdio.conf.ts + generated steps)
BASE_URL=https://practicetestautomation.com

# Maximum parallel WDIO worker instances (default: 1 for local; increase for CI)
WDIO_MAX_INSTANCES=1

# ── Ollama / AI ───────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=30000

# Set to "true" to skip the Ollama health-check on wdio startup
# (useful in CI environments where Ollama is pre-started externally)
SKIP_OLLAMA_CHECK=false

# ── Test URLs ─────────────────────────────────────────────────────────────────
LOGIN_URL=https://practicetestautomation.com/practice-test-login/

# ── Mobile (Appium) ───────────────────────────────────────────────────────────
ANDROID_DEVICE=Pixel_7
ANDROID_VERSION=13.0
ANDROID_APP=./apps/MyApp.apk

IOS_DEVICE=iPhone 14
IOS_VERSION=16.0
IOS_BUNDLE_ID=com.example.myapp
